# Copy to .env and adjust. All settings are prefixed VAD_.

# Absolute base url the mobile app can reach. Muxed download links are built
# from this, so it must NOT be 127.0.0.1 when a real device is the client.
VAD_PUBLIC_BASE_URL=http://192.168.1.10:8000

# Signs refresh tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VAD_SECRET_KEY=change-me

VAD_STORAGE_DIR=storage
VAD_DEBUG=false

# How long we claim a platform CDN url stays valid (seconds).
VAD_DIRECT_URL_TTL=1800
# How long muxed artifacts survive on disk (seconds). Resuming a paused muxed
# download only keeps its byte offset while the artifact is still here.
VAD_JOB_TTL=21600
VAD_REFRESH_TOKEN_TTL=604800

# Seconds /prepare blocks before handing the client a job to poll instead.
VAD_PREPARE_TIMEOUT=60
VAD_MAX_CONCURRENT_MUXES=2

# Leave as `ffmpeg` to discover it on PATH, or give an absolute path.
VAD_FFMPEG_BINARY=ffmpeg
